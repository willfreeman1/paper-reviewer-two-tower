# Copy this file to `.env` and fill in values. Never commit `.env`.

# OpenAlex (free scholarly database). Used to pull the catalog.
OPENALEX_API_KEY=

# Optional. OpenAlex polite-pool contact (not committed). Leave blank to omit.
OPENALEX_MAILTO=

# OpenAI. Used for the last-cut votes and some one-off tag tests.
OPENAI_API_KEY=

# Optional. Some older scripts looked for this.
ANTHROPIC_API_KEY=

# Optional. Last-cut vote model name; default in code is gpt-4o-mini.
STAGE3_MODEL=gpt-4o-mini
