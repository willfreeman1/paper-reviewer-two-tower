# Copy this file to `.env` and fill in values. Never commit `.env`.

# OpenAlex (free scholarly database). Used to pull the catalog.
OPENALEX_API_KEY=

# Optional. OpenAlex polite-pool contact (not committed). Leave blank to omit.
OPENALEX_MAILTO=

# OpenAI. Used for the four-persona votes and the title/abstract tag test.
OPENAI_API_KEY=

# Optional. Vote model name; default in code is gpt-4o-mini.
STAGE3_MODEL=gpt-4o-mini
